<stack class="page">
    <canvas if="{{ isHomeView }}" ref="progressCanvas" class="progress-canvas"></canvas>
    <text if="{{ isHomeView }}" class="time">10:08</text>
    <text if="{{ isHomeView }}" class="amount">{{ totalMl }}</text>
    <text if="{{ isHomeView }}" class="target">/ {{ targetMl }} mL</text>
    <image if="{{ isHomeView }}" class="drop" src="/common/images/water_drop.png"></image>
    <text if="{{ isHomeView }}" class="progress-text">{{ progressText }} · 今日进度</text>
    <div if="{{ isHomeView }}" class="add-button" onclick="onOpenQuickAdd"><text class="add-text">+{{ defaultAmountMl }} mL</text></div>
    <image if="{{ isHomeView }}" class="history-icon" src="/common/images/history.png" onclick="onOpenHistory"></image>
    <text if="{{ isHomeView }}" class="history-text" onclick="onOpenHistory">记录</text>
    <image if="{{ isHomeView }}" class="settings-icon" src="/common/images/settings.png" onclick="onOpenSettings"></image>
    <text if="{{ isHomeView }}" class="settings-text" onclick="onOpenSettings">设置</text>

    <text if="{{ isQuickAddView }}" class="quick-time">10:08</text>
    <text if="{{ isQuickAddView }}" class="quick-title">添加饮水</text>
    <div if="{{ isQuickAddView }}" class="quick-option-100" onclick="onQuickAdd100"><text class="quick-option-text">+100 mL</text></div>
    <div if="{{ isQuickAddView }}" class="quick-option-primary" onclick="onQuickAdd200"><text class="quick-option-primary-text">+200 mL</text></div>
    <div if="{{ isQuickAddView }}" class="quick-option-300" onclick="onQuickAdd300"><text class="quick-option-text">+300 mL</text></div>
    <text if="{{ isQuickAddView }}" class="quick-cancel" onclick="onCancelQuickAdd">取消</text>
</stack>
