<div class="page">
    <stack class="home-stage">
        <image class="progress-ring-image" src="/common/images/home_progress_ring.png"></image>
        <div class="home-overlay">
            <text class="time">10:08</text>
            <div class="metric-block">
                <div class="amount-row">
                    <text class="amount">{{ totalMl }}</text>
                    <text class="amount-unit">/ {{ targetMl }} mL</text>
                </div>
                <text class="progress-label">60% · 今日进度</text>
            </div>
            <div class="primary-button" onclick="onAddWater">
                <text class="primary-button-text">+{{ defaultAmountMl }} mL</text>
            </div>
            <div class="bottom-actions">
                <div class="action" onclick="onOpenHistory">
                    <image class="action-icon" src="/common/images/history.png"></image>
                    <text class="action-text">记录</text>
                </div>
                <div class="action" onclick="onOpenSettings">
                    <image class="action-icon" src="/common/images/settings.png"></image>
                    <text class="action-text">设置</text>
                </div>
            </div>
        </div>
    </stack>
</div>
