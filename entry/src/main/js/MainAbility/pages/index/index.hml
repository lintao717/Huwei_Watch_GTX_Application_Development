<stack class="page">
    <canvas ref="progressCanvas" class="progress-canvas"></canvas>
    <text class="time">10:08</text>
    <text class="amount">{{ totalMl }}</text>
    <text class="target">/ {{ targetMl }} mL</text>
    <image class="drop" src="/common/images/water_drop.png"></image>
    <text class="progress-text">{{ progressText }} · 今日进度</text>
    <div class="add-button" onclick="onAddWater"><text class="add-text">+{{ defaultAmountMl }} mL</text></div>
    <image class="history-icon" src="/common/images/history.png" onclick="onOpenHistory"></image>
    <text class="history-text" onclick="onOpenHistory">记录</text>
    <image class="settings-icon" src="/common/images/settings.png" onclick="onOpenSettings"></image>
    <text class="settings-text" onclick="onOpenSettings">设置</text>
</stack>
